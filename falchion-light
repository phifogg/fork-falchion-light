#!/usr/bin/env python3
"""Small lighting controller for ASUS 0b05:1b04 (wired, interface 01) or its Omni receiver 0b05:1ace (interface 02)."""
import argparse
import fcntl
import os
from pathlib import Path
import select
import struct
import sys
import time

DESCRIPTOR = bytes.fromhex('06 00 ff 09 01 a1 01 09 02 75 08 95 40 15 00 26 ff 00 81 02 09 03 75 08 95 40 15 00 26 ff 00 91 02 c0')
# ROG Omni receiver, interface 02: three vendor collections, report IDs 1-3, 63 bytes each.
OMNI_DESCRIPTOR = bytes.fromhex(
    '06 02 ff 09 01 a1 01 85 01 09 02 75 08 95 3f 15 00 26 ff 00 81 02 09 03 75 08 95 3f 15 00 26 ff 00 91 02 c0'
    '06 00 ff 09 01 a1 01 85 02 09 02 75 08 95 3f 15 00 26 ff 00 81 02 09 03 75 08 95 3f 15 00 26 ff 00 91 02 c0'
    '06 01 ff 09 01 a1 01 85 03 09 02 75 08 95 3f 15 00 26 ff 00 81 02 09 03 75 08 95 3f 15 00 26 ff 00 91 02 c0')
# Wired: unnumbered 64-byte report. Omni receiver: report ID 2 with 63 bytes.
WIRED = {'name': 'USB interface 01', 'product': 0x1b04, 'interface': '01', 'descriptor': DESCRIPTOR, 'report_id': 0, 'size': 64}
OMNI = {'name': 'Omni receiver 0b05:1ace, USB interface 02', 'product': 0x1ace, 'interface': '02', 'descriptor': OMNI_DESCRIPTOR, 'report_id': 2, 'size': 63}
MODES = {'static': 0, 'breathing': 1, 'cycle': 2, 'reactive': 3, 'wave': 4, 'starry': 6, 'raindrop': 9}

def effect_payloads(mode, rgb, brightness, speed):
    """Build vendor payloads; Falchion RX wave uses countdown chunks 2,1,0."""
    speed_byte = {'slow':255, 'medium':128, 'fast':1}[speed]
    if mode == 'wave':
        first = bytes([0x51, 0x2c, 4, 2, speed_byte, brightness, 1, 0, 2])
        return [first.ljust(15, b'\0'),
                bytes([0x51, 0x2c, 4, 1]).ljust(15, b'\0'),
                bytes([0x51, 0x2c, 4, 0]).ljust(15, b'\0')]
    return [bytes([0x51, 0x2c, MODES[mode], 0, speed_byte, brightness, 0, 0, 2]) + rgb]

def battery_status(reply):
    """Parse a 12 01 power reply: percentage at [10], charging flag at [8]."""
    if len(reply) < 11 or not reply.startswith(b'\x12\x01'):
        raise RuntimeError('Unexpected battery reply')
    if reply[10] > 100:
        raise RuntimeError(f'Battery value {reply[10]} out of range')
    return reply[10], reply[8] == 1

# Layout IDs from G-Helper (3, 4, 5, 17) plus 25, read from a Swiss German unit.
LAYOUTS = {3: 'DE', 4: 'UK', 5: 'FR', 17: 'US', 25: 'CH'}
ISO_LAYOUTS = {3, 4, 5, 7, 8, 11, 12, 15, 18, 19, 20, 23, 25}

def active_state(reply):
    """Parse a 12 00 reply: active effect at [9], active profile at [10]."""
    if len(reply) < 11 or not reply.startswith(b'\x12\x00'):
        raise RuntimeError('Unexpected version reply')
    names = {value: name for name, value in MODES.items()}
    effect = names.get(reply[9], f'unknown ({reply[9]:02x})')
    return reply[10], effect

def layout_name(reply):
    """Parse a 12 12 reply: layout ID at [5]."""
    if len(reply) < 6 or not reply.startswith(b'\x12\x12'):
        raise RuntimeError('Unexpected layout reply')
    layout = reply[5]
    kind = 'ISO' if layout in ISO_LAYOUTS else 'ANSI or unknown'
    name = LAYOUTS.get(layout)
    return f'{layout} ({name}, {kind})' if name else f'{layout} ({kind})'

def find(link):
    found = []
    for node in Path('/sys/class/hidraw').glob('hidraw*'):
        device = node / 'device'
        try:
            props = dict(line.split('=', 1) for line in (device / 'uevent').read_text().splitlines() if '=' in line)
            if props.get('HID_ID') != f"0003:00000B05:0000{link['product']:04X}":
                continue
            parent = device.resolve()
            interface = next((p for p in parent.parents if (p / 'bInterfaceNumber').exists()), None)
            if interface is None or (interface / 'bInterfaceNumber').read_text().strip() != link['interface']:
                continue
            if (device / 'report_descriptor').read_bytes() != link['descriptor']:
                raise RuntimeError('Unexpected lighting HID descriptor; refusing device access')
            found.append(Path('/dev') / node.name)
        except FileNotFoundError:
            continue
    if len(found) > 1:
        raise RuntimeError(f"Expected at most one {link['name']}; found {len(found)}")
    return found[0] if found else None

def discover():
    """Prefer the wired keyboard; fall back to the Omni receiver."""
    for link in (WIRED, OMNI):
        path = find(link)
        if path:
            return path, link
    raise RuntimeError('No Falchion RX Low Profile found (wired or Omni receiver)')

def exchange(fd, payload, link=WIRED):
    """Send one report and return the echoed reply without its report ID."""
    # Bound stale-response draining. Never read keyboard input interfaces.
    for _ in range(16):
        if not select.select([fd], [], [], 0)[0]:
            break
        os.read(fd, 64)
    packet = bytes([link['report_id']]) + bytes(payload).ljust(link['size'], b'\0')
    if len(packet) != link['size'] + 1:
        raise RuntimeError('Invalid report length')
    if not select.select([], [fd], [], 1)[1]:
        raise RuntimeError('Timed out waiting to write')
    if os.write(fd, packet) != len(packet):
        raise RuntimeError('Short HID write')
    # The receiver interface also carries report IDs 1 and 3; skip a bounded number of those.
    for _ in range(8):
        if not select.select([fd], [], [], 1)[0]:
            raise RuntimeError('No response from keyboard; outcome unconfirmed')
        reply = os.read(fd, 64)
        print('Response:', reply.hex(' '))
        if not link['report_id']:
            break
        if reply[:1] == bytes([link['report_id']]):
            reply = reply[1:]
            break
    else:
        raise RuntimeError('No reply with the expected report ID; outcome unconfirmed')
    if not reply.startswith(payload):
        raise RuntimeError('Unexpected response; outcome unconfirmed')
    return reply

def keyboard_reachable(reply, link):
    """Through the receiver, a 12 00 reply carries the keyboard firmware at [11..14];
    it is all zero while the keyboard is asleep or off."""
    return link is not OMNI or any(reply[11:15])

def handshake(fd, link):
    reply = exchange(fd, b'\x12\x00', link)
    if not keyboard_reachable(reply, link):
        # Give a sleeping keyboard one chance to wake up, then stop.
        time.sleep(0.5)
        reply = exchange(fd, b'\x12\x00', link)
        if not keyboard_reachable(reply, link):
            raise RuntimeError('Receiver answered but the keyboard did not; is it switched on and in 2.4 GHz mode?')
    return reply

def color(value):
    value = value.removeprefix('#')
    if len(value) != 6 or any(c not in '0123456789abcdefABCDEF' for c in value):
        raise argparse.ArgumentTypeError('Use six hexadecimal digits, e.g. 336699')
    return bytes.fromhex(value)

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='command', required=True)
    sub.add_parser('info', help='Identify the control interface without sending commands')
    sub.add_parser('probe', help='Send a version query; does not change lighting')
    sub.add_parser('battery', help='Query battery level and charging state; does not change lighting')
    sub.add_parser('layout', help='Query the keyboard layout ID; does not change lighting')
    lighting = sub.add_parser('set', help='Set a hardware lighting effect')
    lighting.add_argument('mode', choices=MODES)
    lighting.add_argument('color', type=color, help='RGB hex color (ignored by cycle and wave)')
    lighting.add_argument('--brightness', type=int, choices=range(0, 101), default=50, metavar='0..100')
    lighting.add_argument('--speed', choices=['slow', 'medium', 'fast'], default='medium')
    lighting.add_argument('--save', action='store_true', help='Explicitly apply/save to keyboard memory')
    lighting.add_argument('--dry-run', action='store_true', help='Print payload without accessing hardware')
    args = parser.parse_args()
    payloads = []
    if args.command == 'set':
        payloads = effect_payloads(args.mode, args.color, args.brightness, args.speed)
        if args.dry_run:
            for payload in payloads:
                print('Report (zero report ID + 64-byte payload):', (b'\0' + payload.ljust(64, b'\0')).hex(' '))
            return
    path, link = discover()
    print(f"ROG Falchion RX Low Profile, {link['name']}: {path}")
    if args.command == 'info':
        print('Descriptor verified. No HID commands sent.')
        return
    fd = os.open(path, os.O_RDWR | os.O_NONBLOCK | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        # Recheck identity on the opened fd to guard against device-node reuse.
        info = bytearray(8)
        fcntl.ioctl(fd, 0x80084803, info, True)
        if struct.unpack('Ihh', info) != (3, 0x0b05, link['product']):
            raise RuntimeError('Opened device identity mismatch')
        size = bytearray(4)
        fcntl.ioctl(fd, 0x80044801, size, True)
        if struct.unpack('I', size)[0] != len(link['descriptor']):
            raise RuntimeError('Opened device descriptor length mismatch')
        descriptor = bytearray(4100)
        struct.pack_into('I', descriptor, 0, len(link['descriptor']))
        fcntl.ioctl(fd, 0x90044802, descriptor, True)
        if descriptor[4:4 + len(link['descriptor'])] != link['descriptor']:
            raise RuntimeError('Opened device descriptor mismatch')
        profile, effect = active_state(handshake(fd, link))
        if args.command == 'probe':
            print(f'Active profile: {profile}, effect: {effect}')
        if args.command == 'battery':
            time.sleep(0.06)
            percent, charging = battery_status(exchange(fd, b'\x12\x01', link))
            print(f'Battery: {percent}%' + (', charging' if charging else ''))
        if args.command == 'layout':
            time.sleep(0.06)
            print('Layout ID:', layout_name(exchange(fd, b'\x12\x12', link)))
        if payloads:
            for payload in payloads:
                time.sleep(0.06)
                exchange(fd, payload, link)
            if args.save:
                time.sleep(0.06)
                exchange(fd, b'\x50\x55', link)
            print('Lighting command replied; confirm appearance on keyboard.')
    finally:
        os.close(fd)

if __name__ == '__main__':
    try:
        main()
    except (OSError, RuntimeError) as error:
        print(f'Error: {error}', file=sys.stderr)
        sys.exit(1)
